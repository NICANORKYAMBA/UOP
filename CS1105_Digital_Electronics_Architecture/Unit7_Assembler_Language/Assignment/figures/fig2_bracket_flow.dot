digraph G {
  nodesep=0.3; ranksep=0.35;
  node [fontname="Helvetica", fontsize=11, style=filled, fillcolor="#dae8fc", shape=box];
  edge [fontname="Helvetica", fontsize=10];
  start [shape=oval, fillcolor="#eeeeee", label="check_brackets (ESI = string)"];
  init  [label="stack_init,  position = 0"];
  read  [label="AL = next character,  position + 1"];
  end   [shape=diamond, fillcolor="#fff2cc", label="end of\nstring?"];
  open  [shape=diamond, fillcolor="#fff2cc", label="( [ { ?"];
  close [shape=diamond, fillcolor="#fff2cc", label=") ] } ?"];
  push  [fillcolor="#d5e8d4", label="stack_push AL"];
  ovf   [shape=diamond, fillcolor="#fff2cc", label="CF = 1?"];
  pop   [fillcolor="#f8cecc", label="AH = matching opener\nstack_pop -> AL"];
  empty [shape=diamond, fillcolor="#fff2cc", label="CF = 1?"];
  match [shape=diamond, fillcolor="#fff2cc", label="AL = AH?"];
  left  [shape=diamond, fillcolor="#fff2cc", label="stack_size\n= 0?"];
  cont [shape=box, style="rounded,filled", fillcolor="#eeeeee", label="continue with\nnext character"];
  r0 [shape=oval, fillcolor="#d5e8d4", label="0: balanced"];
  r1 [shape=oval, fillcolor="#f8cecc", label="1: no opening bracket"];
  r2 [shape=oval, fillcolor="#f8cecc", label="2: wrong kind of bracket"];
  r3 [shape=oval, fillcolor="#f8cecc", label="3: brackets never closed"];
  r4 [shape=oval, fillcolor="#f8cecc", label="4: stack overflow"];
  start -> init -> read -> end;
  end -> left [label=" yes"];
  end -> open [label=" no"];
  left -> r0 [label=" yes"];
  left -> r3 [label=" no"];
  open -> push [label=" yes"];
  open -> close [label=" no"];
  push -> ovf;
  ovf -> r4 [label=" yes"];
  ovf -> cont [label=" no"];
  close -> pop [label=" yes"];
  close -> cont [label=" no (other\n character)"];
  pop -> empty;
  empty -> r1 [label=" yes"];
  empty -> match [label=" no"];
  match -> cont [label=" yes"];
  cont -> read [constraint=false, label=" loop"];
  match -> r2 [label=" no"];
}
