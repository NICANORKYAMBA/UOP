// Figure 1: conceptual ER diagram in Chen notation.
// Double line = total participation, single line = partial participation.
graph ERD {
  graph [layout=neato, overlap=false, splines=true, sep="+12", fontname="Helvetica", outputorder=edgesfirst, bgcolor=white, pad=0.3];
  node  [fontname="Helvetica", fontsize=12];
  edge  [fontname="Helvetica-Bold", fontsize=13, len=1.3];

  node [shape=box, style=filled, fillcolor="#dbe8f7", penwidth=1.6, width=1.3, height=0.55, fontsize=14];
  CUSTOMER [label=<<B>CUSTOMER</B>>, pos="0,0!"];
  ORDER    [label=<<B>ORDER</B>>,    pos="5,0!"];
  PRODUCT  [label=<<B>PRODUCT</B>>,  pos="10,0!"];
  INVENTORY[label=<<B>INVENTORY</B>>,pos="10,-5!"];

  node [shape=diamond, style=filled, fillcolor="#fde9c9", penwidth=1.4, width=1.6, height=0.9, fontsize=12];
  PLACES   [label=<<B>Places</B>>,   pos="2.5,0!"];
  CONTAINS [label=<<B>Contains</B>>, pos="7.5,0!"];
  TRACKED  [label=<<B>Tracked in</B>>, pos="10,-2.5!"];

  node [shape=ellipse, style=filled, fillcolor=white, penwidth=1.0, width=0, height=0, margin="0.06,0.03"];
  c_id   [label=<<U>customer_id</U>>, pos="-1.6,2.0!"];
  c_fn   [label="first_name",       pos="-2.6,1.0!"];
  c_ln   [label="last_name",        pos="-2.8,0!"];
  c_em   [label="email",            pos="-2.6,-1.0!"];
  c_ph   [label="phone",            pos="-1.7,-1.9!"];
  c_ad   [label="shipping_address", pos="0.2,-2.3!"];

  o_id   [label=<<U>order_id</U>>,  pos="3.9,2.0!"];
  o_dt   [label="order_date",       pos="5.4,2.2!"];
  o_st   [label="status",           pos="4.0,-1.9!"];
  o_tot  [label="total_amount",     pos="5.8,-1.9!"];

  r_q    [label="quantity",         pos="6.7,1.8!"];
  r_up   [label="unit_price",       pos="8.3,1.8!"];

  p_id   [label=<<U>product_id</U>>, pos="11.9,1.9!"];
  p_sku  [label="sku",              pos="12.6,0.9!"];
  p_nm   [label="product_name",     pos="12.9,0!"];
  p_cat  [label="category",         pos="12.6,-0.9!"];
  p_pr   [label="unit_price",       pos="10.4,2.0!"];

  i_id   [label=<<U>inventory_id</U>>, pos="12.4,-4.2!"];
  i_wh   [label="warehouse_location", pos="12.8,-5.2!"];
  i_q    [label="quantity_on_hand",   pos="11.9,-6.2!"];
  i_rl   [label="reorder_level",      pos="9.6,-6.5!"];
  i_lu   [label="last_updated",       pos="7.9,-5.6!"];

  CUSTOMER -- {c_id c_fn c_ln c_em c_ph c_ad};
  ORDER    -- {o_id o_dt o_st o_tot};
  CONTAINS -- {r_q r_up};
  PRODUCT  -- {p_id p_sku p_nm p_cat p_pr};
  INVENTORY-- {i_id i_wh i_q i_rl i_lu};

  // Relationships with cardinality labels; "black:invis:black" draws a double (total) line.
  CUSTOMER -- PLACES   [label="1", penwidth=1.6];
  PLACES   -- ORDER    [label="N", color="black:invis:black", penwidth=1.6];
  ORDER    -- CONTAINS [label="M", color="black:invis:black", penwidth=1.6];
  CONTAINS -- PRODUCT  [label="N", penwidth=1.6];
  PRODUCT  -- TRACKED  [label="1", penwidth=1.6];
  TRACKED  -- INVENTORY[label="N", color="black:invis:black", penwidth=1.6];

  legend [shape=plain, pos="1.5,-5.3!", label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3" BGCOLOR="#f7f7f7">
      <TR><TD ALIGN="LEFT"><B>Key</B></TD></TR>
      <TR><TD ALIGN="LEFT">Rectangle = entity, diamond = relationship, oval = attribute</TD></TR>
      <TR><TD ALIGN="LEFT"><U>Underlined</U> attribute = primary key</TD></TR>
      <TR><TD ALIGN="LEFT">Double line = total participation (must take part)</TD></TR>
      <TR><TD ALIGN="LEFT">Single line = partial participation (may take part)</TD></TR>
      <TR><TD ALIGN="LEFT">1, N, M = cardinality</TD></TR>
    </TABLE>>];
}
