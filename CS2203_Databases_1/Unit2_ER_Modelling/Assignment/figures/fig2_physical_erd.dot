digraph Physical {
  graph [rankdir=LR, nodesep=0.9, ranksep=1.9, fontname="Helvetica", bgcolor=white, pad=0.3];
  node [shape=plain, fontname="Helvetica", fontsize=11];
  edge [dir=both, penwidth=1.5, fontname="Helvetica-Bold", fontsize=11, arrowsize=1.2];
  Customer [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#1f5aa6"><FONT COLOR="white"><B>Customer</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8a1c1c"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="customer_id"><B><U>customer_id</U></B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT" PORT="first_name">first_name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT" PORT="last_name">last_name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8a1c1c"><B>UQ</B></FONT></TD><TD ALIGN="LEFT" PORT="email">email</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT" PORT="phone">phone</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT" PORT="shipping_address">shipping_address</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(255)</FONT></TD></TR></TABLE>>];
  Orders [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#1f5aa6"><FONT COLOR="white"><B>Orders</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8a1c1c"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="order_id"><B><U>order_id</U></B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8a1c1c"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="customer_id">customer_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT" PORT="order_date">order_date</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT" PORT="total_amount">total_amount</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">DECIMAL(10,2)</FONT></TD></TR></TABLE>>];
  Order_Item [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#1f5aa6"><FONT COLOR="white"><B>Order_Item</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8a1c1c"><B>PK, FK</B></FONT></TD><TD ALIGN="LEFT" PORT="order_id"><B><U>order_id</U></B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8a1c1c"><B>PK, FK</B></FONT></TD><TD ALIGN="LEFT" PORT="product_id"><B><U>product_id</U></B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT" PORT="quantity">quantity</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT" PORT="unit_price">unit_price</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">DECIMAL(10,2)</FONT></TD></TR></TABLE>>];
  Product [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#1f5aa6"><FONT COLOR="white"><B>Product</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8a1c1c"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="product_id"><B><U>product_id</U></B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8a1c1c"><B>UQ</B></FONT></TD><TD ALIGN="LEFT" PORT="sku">sku</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT" PORT="product_name">product_name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT" PORT="category">category</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT" PORT="unit_price">unit_price</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">DECIMAL(10,2)</FONT></TD></TR></TABLE>>];
  Inventory [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#1f5aa6"><FONT COLOR="white"><B>Inventory</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8a1c1c"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="inventory_id"><B><U>inventory_id</U></B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8a1c1c"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="product_id">product_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT" PORT="warehouse_location">warehouse_location</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT" PORT="quantity_on_hand">quantity_on_hand</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT" PORT="reorder_level">reorder_level</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT" PORT="last_updated">last_updated</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">DATE</FONT></TD></TR></TABLE>>];
  Customer -> Orders [arrowtail=teetee, arrowhead=crowodot, tailport=e, headport=w, label=<<B>places</B><BR/>1..1 to 0..*>];
  Orders -> Order_Item [arrowtail=teetee, arrowhead=crowtee, tailport=e, headport=w, label=<<B>contains</B><BR/>1..1 to 1..*>];
  Product -> Order_Item [arrowtail=teetee, arrowhead=crowodot, tailport=e, headport=s, label=<<B>appears in</B><BR/>1..1 to 0..*>];
  Product -> Inventory [arrowtail=teetee, arrowhead=crowodot, tailport=e, headport=w, label=<<B>stocked as</B><BR/>1..1 to 0..*>];
  { rank=same; Orders; Product; }
  { rank=same; Order_Item; Inventory; }
  legend [label=<<TABLE BORDER="1" CELLBORDER="0" CELLPADDING="3" BGCOLOR="#f7f7f7"><TR><TD ALIGN="LEFT"><B>Key</B></TD></TR><TR><TD ALIGN="LEFT">PK = primary key, FK = foreign key, UQ = unique</TD></TR><TR><TD ALIGN="LEFT">Two bars = exactly one (1..1), mandatory</TD></TR><TR><TD ALIGN="LEFT">Bar + crow's foot = one or many (1..*), mandatory</TD></TR><TR><TD ALIGN="LEFT">Circle + crow's foot = zero or many (0..*), optional</TD></TR></TABLE>>];
  { rank=same; Customer; legend; }
}
